# Normalize line endings for everyone.
#
# Without this, checkout on Windows depends on each developer's core.autocrlf
# and produces CRLF working copies, while .editorconfig and both formatters
# (dotnet format, Spotless) are set to LF. That mismatch makes the formatters
# report every file as needing a rewrite on a fresh clone. Declaring it here
# settles it in the repository instead of per machine.

* text=auto eol=lf

# Windows-only scripts must keep CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf

# Gradle wrapper
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary assets: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
