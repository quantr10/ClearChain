# Database
DATABASE_URL=Host=your-supabase-host;Port=5432;Database=postgres;Username=postgres.xxxxx;Password=your_password

# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ISSUER=clearchain-api
JWT_AUDIENCE=clearchain-mobile
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# Firebase
FIREBASE_SERVER_KEY=your-firebase-server-key-here

# Azure Computer Vision (food image analysis)
AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_VISION_KEY=your_azure_vision_key_here

# SMTP (transactional email via MailKit)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://clearchain.app

# Environment
ASPNETCORE_ENVIRONMENT=Development