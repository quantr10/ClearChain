<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices older than API 31 (ignored on API 31+, see
   data_extraction_rules.xml for that).
   See https://developer.android.com/guide/topics/data/autobackup for details.
-->
<full-backup-content>
    <!-- The Room database holds the signed-in user's access/refresh tokens (AuthTokenEntity)
         alongside the offline cache — excluded wholesale since backup can't split a single
         database file by table, and the cache itself is just a re-fetchable cache. -->
    <exclude domain="database" path="clearchain_db" />
    <exclude domain="database" path="clearchain_db-wal" />
    <exclude domain="database" path="clearchain_db-shm" />
    <exclude domain="database" path="clearchain_db-journal" />
</full-backup-content>
