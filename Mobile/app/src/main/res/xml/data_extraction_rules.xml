<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for API 31+ (cloud backup and device-to-device transfer).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The Room database holds the signed-in user's access/refresh tokens
             (AuthTokenEntity) alongside the offline cache — excluded wholesale since
             backup can't split a single database file by table. -->
        <exclude domain="database" path="clearchain_db" />
        <exclude domain="database" path="clearchain_db-wal" />
        <exclude domain="database" path="clearchain_db-shm" />
        <exclude domain="database" path="clearchain_db-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="clearchain_db" />
        <exclude domain="database" path="clearchain_db-wal" />
        <exclude domain="database" path="clearchain_db-shm" />
        <exclude domain="database" path="clearchain_db-journal" />
    </device-transfer>
</data-extraction-rules>
